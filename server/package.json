{
  "name": "visiondesk-server",
  "version": "1.0.0",
  "description": "VisionDesk Central Server & WebSocket Relay Core for Arequipa Branches",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node --optimize-for-size --max-old-space-size=32 --gc-interval=100 server.js",
    "start:gc": "node --optimize-for-size --max-old-space-size=32 --max-semi-space-size=1 --expose-gc --gc-interval=100 server.js",
    "dev": "node --watch server.js",
    "test": "node --test ../test/**/*.test.js",
    "test:integration": "node --test ../test/m1_server.test.js",
    "verify:memory": "node ../test/verify_memory.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {},
  "private": true,
  "author": "VisionDesk Team",
  "license": "UNLICENSED"
}
